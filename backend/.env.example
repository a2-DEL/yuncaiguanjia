# 应用
APP_NAME=云财管家 API
ENV=dev
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 数据库（Docker 内服务名）
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_pwd
POSTGRES_DB=finance_system
DATABASE_URL=postgresql+asyncpg://finance:finance_dev_pwd@db:5432/finance_system

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO（对象存储，存发票图片/附件）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finance-attachments
MINIO_SECURE=false

# JWT
JWT_SECRET=change-me-in-production-please-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 初始管理员
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123456
FIRST_ADMIN_NAME=张明
